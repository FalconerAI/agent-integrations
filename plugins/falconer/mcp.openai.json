{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "falconer": {
      "type": "streamable-http",
      "url": "https://falconer.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "falconer-openai-plugin",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
